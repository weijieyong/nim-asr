# =============================================================================
# Configuration for dictation client and Riva NIM server
# Copy to .env and adjust as needed
# =============================================================================

# --- NVIDIA NGC API Key (REQUIRED for Riva server) ---
# Get from https://org.ngc.nvidia.com/
# NGC_API_KEY=nvapi-...

# --- Docker Compose / Riva Server ---
CONTAINER_ID=parakeet-1-1b-ctc-en-us
NIM_TAGS_SELECTOR=name=parakeet-1-1b-ctc-en-us,mode=str,vad=default,diarizer=disabled
NIM_DISABLE_MODEL_DOWNLOAD=true

# --- Paths (adjust to your home directory) ---
LOCAL_NIM_CACHE=~/.cache/nim
RIVA_MODELS_PATH=./riva-models/models

# --- API Ports ---
NIM_HTTP_API_PORT=9000
NIM_GRPC_API_PORT=50051

# --- Dictation Client (optional) ---
# Specific microphone device index (leave unset for system default)
# Run: uv run mic_check.py  to find your device index
# NIM_ASR_INPUT_DEVICE_INDEX=

# Sample rate for mic capture (leave unset unless your device rejects 16 kHz)
# NIM_ASR_CAPTURE_SAMPLE_RATE=44100